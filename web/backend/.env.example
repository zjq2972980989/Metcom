# MetCom Web backend example configuration.
# Copy this file to web/backend/.env and adjust paths for your machine.
# Never commit the real .env file.

# HTTP server
# METCOM_WEB_HOST=127.0.0.1
# METCOM_WEB_PORT=8000

# Optional external data locations. If omitted, paths under web/data are used.
# METCOM_WEB_METCOM_DATA_ROOT=C:/data/metcom/raw
# METCOM_WEB_METCOM_DEPENDENT_DIR=C:/data/metcom/dependent
# METCOM_WEB_METCOM_SITE_FILE=C:/data/metcom/dependent/sites/sta_30sits.txt
# METCOM_WEB_METCOM_CDSAPIRC=C:/Users/your-name/.cdsapirc

# Calculation and archive limits
# METCOM_WEB_METCOM_OUTPUT_FORMAT=txt
# METCOM_WEB_RESULT_ZIP_MAX_MB=512
# METCOM_WEB_PRODUCT_ZIP_MAX_MB=512

# Development CORS origins (JSON list).
# METCOM_WEB_DEV_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# NASA Earthdata credentials are read by the calculation engine from the
# process environment, not from this file. Set EARTHDATA_USERNAME and
# EARTHDATA_PASSWORD in the OS environment, or configure ~/.netrc.
